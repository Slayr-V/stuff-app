# Environment variables for local development.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Only variables prefixed with EXPO_PUBLIC_ are
# bundled into the client — anything secret (AI provider keys, service-role
# keys, etc.) belongs server-side (Supabase Edge Functions), never here.
#
# This file is intentionally close to empty right now. Client-facing config
# (e.g. EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY) is added
# in the Supabase Integration stage, not before it's needed.

EXPO_PUBLIC_APP_ENV=development
