# Environment variables for local development.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Only variables prefixed with EXPO_PUBLIC_ are
# bundled into the client — anything secret (AI provider keys, service-role
# keys, etc.) belongs server-side (Supabase Edge Functions), never here.

EXPO_PUBLIC_APP_ENV=development

# Development Supabase project (Settings -> API in the Supabase dashboard).
# The anon key is safe to expose client-side by design — every table it can
# reach must be protected by Row Level Security. Never put the
# service-role key here or anywhere in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
